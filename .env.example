# Zerodha AI Financial Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to Git.

# Market data provider (Alpha Vantage free tier)
MARKET_API_KEY=your_alpha_vantage_api_key_here

# MCP Server endpoint (local development)
MCP_SERVER_URL=http://localhost:8001

# Google Gemini API (for LLM analysis, optional for prototype)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (SQLite for development)
DATABASE_URL=sqlite:///./zerodha.db
